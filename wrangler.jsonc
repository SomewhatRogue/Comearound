{
  // Cloudflare deploy: one Durable Object per room, static client from dist/.
  "name": "comebye",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "dist", "not_found_handling": "single-page-application", "run_worker_first": ["/parties/*"] },
  "durable_objects": { "bindings": [{ "name": "GameServer", "class_name": "GameServer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameServer"] }]
}
